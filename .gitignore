
# Large bulk data (not the small demo split under data/)
*.bam
*.cram
*.fastq
*.fq
*.bed
*.sam
*.h5
*.pt
*.pth
*.ckpt
*.npz
*.parquet
*.pkl

# Ignore VCF archives by default...
*.vcf.gz
# ...but keep the curated demo train/test subset tracked in-repo
!data/
!data/**
!data/train/*.vcf.gz
!data/test/*.vcf.gz

# Large local result trees
/results/

# Python tooling caches
.mypy_cache/
