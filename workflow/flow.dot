digraph NetworkParser_TwoLevel {
  rankdir=TB;
  labelloc="t";
  fontsize=22;
  fontname="Helvetica";

  label=<
    <B>NetworkParser — Two-Level Workflow</B><BR/>
    Training/discovery pipeline plus raw-sequence query mode for strain placement and resistance prediction
  >;

  graph [
    splines=ortho,
    nodesep=0.45,
    ranksep=0.70,
    pad=0.25,
    bgcolor="white"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    color="#4F6D8A",
    penwidth=1.1,
    fillcolor="#EEF5FF"
  ];

  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#444444",
    penwidth=1.0,
    arrowsize=0.8
  ];

  // ============================================================
  // STAGE 0 — ENTRY / CONFIG / ORCHESTRATION
  // ============================================================
  subgraph cluster_orch {
    label="Stage 0 — Entry, configuration, and orchestration";
    style="rounded,filled";
    color="#D6E4F0";
    fillcolor="#F8FBFF";
    fontsize=14;

    cli [label=<
      <B>cli.py</B><BR ALIGN="LEFT"/>
      Command-line entry point<BR ALIGN="LEFT"/>
      • run<BR ALIGN="LEFT"/>
      • train-two-level<BR ALIGN="LEFT"/>
      • query<BR ALIGN="LEFT"/>
      • genomic input<BR ALIGN="LEFT"/>
      • metadata<BR ALIGN="LEFT"/>
      • Level 1 label column<BR ALIGN="LEFT"/>
      • Level 2 label column<BR ALIGN="LEFT"/>
      • output directory<BR ALIGN="LEFT"/>
      • query input type
    >];

    config [label=<
      <B>config.py</B><BR ALIGN="LEFT"/>
      Central settings<BR ALIGN="LEFT"/>
      • preprocessing controls<BR ALIGN="LEFT"/>
      • artifact / low-count controls<BR ALIGN="LEFT"/>
      • RF-FDR / association-FDR settings<BR ALIGN="LEFT"/>
      • ML protocol settings<BR ALIGN="LEFT"/>
      • decision-tree settings<BR ALIGN="LEFT"/>
      • bootstrap / confidence settings<BR ALIGN="LEFT"/>
      • two-level protocol settings<BR ALIGN="LEFT"/>
      • raw-sequence query settings
    >];

    orchestrator [label=<
      <B>network_parser.py</B><BR ALIGN="LEFT"/>
      Main orchestrator<BR ALIGN="LEFT"/>
      • receives CLI + config<BR ALIGN="LEFT"/>
      • runs data loading<BR ALIGN="LEFT"/>
      • routes into two-level protocol<BR ALIGN="LEFT"/>
      • collects final outputs
    > fillcolor="#E2F0FF"];

    cli -> orchestrator;
    config -> orchestrator;
  }

  // ============================================================
  // STAGE 1 — DATA LOADING / PREPROCESSING / MANIFEST
  // ============================================================
  subgraph cluster_data {
    label="Stage 1 — Data loading, preprocessing, and feature manifest construction";
    style="rounded,filled";
    color="#D6E4F0";
    fillcolor="#F8FBFF";
    fontsize=14;

    genomic_input [label=<
      <B>Training genomic input</B><BR ALIGN="LEFT"/>
      • VCFs / VCF directory<BR ALIGN="LEFT"/>
      • or existing genomic feature matrix
    > shape=parallelogram fillcolor="#FFF8DC"];

    reference_input [label=<
      <B>Reference / annotation input</B><BR ALIGN="LEFT"/>
      Optional but required for raw-sequence query support<BR ALIGN="LEFT"/>
      • reference FASTA / GenBank<BR ALIGN="LEFT"/>
      • genomic coordinates<BR ALIGN="LEFT"/>
      • flanking context<BR ALIGN="LEFT"/>
      • gene / region annotation where available
    > shape=parallelogram fillcolor="#FFF8DC"];

    metadata_input [label=<
      <B>Metadata input</B><BR ALIGN="LEFT"/>
      sample IDs + supervised labels<BR ALIGN="LEFT"/>
      • Level 1 label = strain / lineage / group<BR ALIGN="LEFT"/>
      • Level 2 label = AMR phenotype / resistance profile
    > shape=parallelogram fillcolor="#FFF8DC"];

    data_loader [label=<
      <B>data_loader.py</B><BR ALIGN="LEFT"/>
      Build / load sample x genomic-feature matrix<BR ALIGN="LEFT"/>
      • parse VCF or matrix<BR ALIGN="LEFT"/>
      • apply QC filters<BR ALIGN="LEFT"/>
      • remove invariant features<BR ALIGN="LEFT"/>
      • handle missing values<BR ALIGN="LEFT"/>
      • apply artifact / low-count controls<BR ALIGN="LEFT"/>
      • preserve feature identity
    >];

    aligned_matrix [label=<
      <B>Aligned supervised matrix</B><BR ALIGN="LEFT"/>
      Output:<BR ALIGN="LEFT"/>
      • X = sample x genomic-feature matrix<BR ALIGN="LEFT"/>
      • metadata aligned by sample ID<BR ALIGN="LEFT"/>
      • ready for central feature filtering
    > fillcolor="#DDF5DD"];

    feature_manifest [label=<
      <B>All-feature manifest</B><BR ALIGN="LEFT"/>
      Carries annotation forward<BR ALIGN="LEFT"/>
      • Feature_ID<BR ALIGN="LEFT"/>
      • chrom / position / REF / ALT<BR ALIGN="LEFT"/>
      • baseline allele<BR ALIGN="LEFT"/>
      • encoding rule<BR ALIGN="LEFT"/>
      • context sequence<BR ALIGN="LEFT"/>
      • marker-centre index<BR ALIGN="LEFT"/>
      • gene / region annotation where available
    > fillcolor="#E9FFF2"];

    genomic_input -> data_loader;
    reference_input -> data_loader;
    metadata_input -> data_loader;
    data_loader -> aligned_matrix;
    data_loader -> feature_manifest;
  }

  orchestrator -> data_loader;

  // ============================================================
  // STAGE 2 — TWO-LEVEL CONTROLLER
  // ============================================================
  subgraph cluster_twolevel {
    label="Stage 2 — Two-level protocol controller";
    style="rounded,filled";
    color="#D9EAD3";
    fillcolor="#FAFFFA";
    fontsize=14;

    two_level_controller [label=<
      <B>two_level_protocol.py</B><BR ALIGN="LEFT"/>
      Coordinates two supervised biological tasks<BR ALIGN="LEFT"/>
      • Level 1: strain / sample placement<BR ALIGN="LEFT"/>
      • Level 2: resistance profile prediction<BR ALIGN="LEFT"/>
      • saves model registry<BR ALIGN="LEFT"/>
      • saves selected feature manifests
    > fillcolor="#E9FFF2"];
  }

  aligned_matrix -> two_level_controller;
  feature_manifest -> two_level_controller;

  // ============================================================
  // LEVEL 1
  // ============================================================
  subgraph cluster_level1 {
    label="Level 1 — Strain / sample identification";
    style="rounded,filled";
    color="#CFE2F3";
    fillcolor="#F8FCFF";
    fontsize=14;

    lvl1_label [label=<
      <B>Level 1 supervised target</B><BR ALIGN="LEFT"/>
      strain / lineage / clade / cluster / group label
    > shape=parallelogram fillcolor="#FFF8DC"];

    lvl1_filter [label=<
      <B>Central feature filtering for Level 1</B><BR ALIGN="LEFT"/>
      statistical_validation_branch.py / feature_selection.py<BR ALIGN="LEFT"/>
      Happens before model training and before tree construction<BR ALIGN="LEFT"/>
      • RF-FDR or association-FDR<BR ALIGN="LEFT"/>
      • empirical p-values where enabled<BR ALIGN="LEFT"/>
      • FDR-BH correction<BR ALIGN="LEFT"/>
      Output:<BR ALIGN="LEFT"/>
      • Level 1 filtered matrix<BR ALIGN="LEFT"/>
      • selected placement features
    > fillcolor="#E7F2FF"];

    lvl1_selected_manifest [label=<
      <B>Level 1 selected feature manifest</B><BR ALIGN="LEFT"/>
      Subset of all-feature manifest<BR ALIGN="LEFT"/>
      matching retained Level 1 features<BR ALIGN="LEFT"/>
      Used later for raw-sequence query reconstruction
    > fillcolor="#E9FFF2"];

    lvl1_selector [label=<
      <B>model_selector.py</B><BR ALIGN="LEFT"/>
      Assess Level 1 matrix / label structure<BR ALIGN="LEFT"/>
      and recommend suitable model family
    >];

    lvl1_ml [label=<
      <B>ml_protocol.py</B><BR ALIGN="LEFT"/>
      <B>Level 1 ML protocol</B><BR ALIGN="LEFT"/>
      Train strain-placement model<BR ALIGN="LEFT"/>
      • training / evaluation<BR ALIGN="LEFT"/>
      • model artifact<BR ALIGN="LEFT"/>
      • feature list preserved
    >];

    lvl1_backend [label=<
      <B>neural_network.py</B><BR ALIGN="LEFT"/>
      Backend learners / model wrappers<BR ALIGN="LEFT"/>
      used by the ML protocol
    >];

    lvl1_dt_gate [label=<
      <B>Run Level 1 decision tree?</B>
    > shape=diamond fillcolor="#FFF2CC"];

    lvl1_dt [label=<
      <B>decision_tree_branch.py</B><BR ALIGN="LEFT"/>
      <B>Level 1 decision tree</B><BR ALIGN="LEFT"/>
      Interpret strain-placement rules<BR ALIGN="LEFT"/>
      • root / branch features<BR ALIGN="LEFT"/>
      • rule extraction<BR ALIGN="LEFT"/>
      • path-based interactions
    > fillcolor="#E7F2FF"];

    lvl1_conf [label=<
      <B>Level 1 post-tree confidence</B><BR ALIGN="LEFT"/>
      Happens after tree construction<BR ALIGN="LEFT"/>
      • bootstrap stability<BR ALIGN="LEFT"/>
      • mutual information<BR ALIGN="LEFT"/>
      • feature confidence scores
    > fillcolor="#E7F2FF"];

    lvl1_output [label=<
      <B>Level 1 outputs</B><BR ALIGN="LEFT"/>
      • trained Level 1 model<BR ALIGN="LEFT"/>
      • selected placement features<BR ALIGN="LEFT"/>
      • Level 1 selected manifest<BR ALIGN="LEFT"/>
      • optional DT explanations<BR ALIGN="LEFT"/>
      • optional confidence summaries
    > fillcolor="#DDF5DD"];

    lvl1_label -> lvl1_filter;
    lvl1_filter -> lvl1_selected_manifest;
    lvl1_filter -> lvl1_selector;
    lvl1_selector -> lvl1_ml;
    lvl1_ml -> lvl1_backend;
    lvl1_backend -> lvl1_dt_gate;
    lvl1_dt_gate -> lvl1_dt [label="yes"];
    lvl1_dt_gate -> lvl1_output [label="no"];
    lvl1_dt -> lvl1_conf;
    lvl1_conf -> lvl1_output;
    lvl1_selected_manifest -> lvl1_output;
  }

  two_level_controller -> lvl1_label;
  feature_manifest -> lvl1_selected_manifest [style=dashed label="subset by retained features"];

  // ============================================================
  // LEVEL 2
  // ============================================================
  subgraph cluster_level2 {
    label="Level 2 — Resistance profile prediction";
    style="rounded,filled";
    color="#F4CCCC";
    fillcolor="#FFF9F9";
    fontsize=14;

    lvl2_label [label=<
      <B>Level 2 supervised target</B><BR ALIGN="LEFT"/>
      AMR phenotype / resistance profile / class label
    > shape=parallelogram fillcolor="#FFF8DC"];

    lvl2_context [label=<
      <B>Level 2 training context</B><BR ALIGN="LEFT"/>
      • global Level 2 model where enabled<BR ALIGN="LEFT"/>
      • optional group-specific Level 2 models<BR ALIGN="LEFT"/>
      • Level 1 grouping may define subgroup context
    > fillcolor="#FFF2CC"];

    lvl2_filter [label=<
      <B>Central feature filtering for Level 2</B><BR ALIGN="LEFT"/>
      statistical_validation_branch.py / feature_selection.py<BR ALIGN="LEFT"/>
      Happens before model training and before tree construction<BR ALIGN="LEFT"/>
      • RF-FDR or association-FDR<BR ALIGN="LEFT"/>
      • empirical p-values where enabled<BR ALIGN="LEFT"/>
      • FDR-BH correction<BR ALIGN="LEFT"/>
      Output:<BR ALIGN="LEFT"/>
      • Level 2 filtered matrix<BR ALIGN="LEFT"/>
      • selected AMR-associated features
    > fillcolor="#FCE8E8"];

    lvl2_selected_manifest [label=<
      <B>Level 2 selected feature manifest</B><BR ALIGN="LEFT"/>
      Subset of all-feature manifest<BR ALIGN="LEFT"/>
      matching retained Level 2 features<BR ALIGN="LEFT"/>
      May exist for global and group-specific models<BR ALIGN="LEFT"/>
      Used later for raw-sequence query reconstruction
    > fillcolor="#E9FFF2"];

    lvl2_selector [label=<
      <B>model_selector.py</B><BR ALIGN="LEFT"/>
      Assess Level 2 matrix / label structure<BR ALIGN="LEFT"/>
      and recommend suitable model family
    >];

    lvl2_ml [label=<
      <B>ml_protocol.py</B><BR ALIGN="LEFT"/>
      <B>Level 2 ML protocol</B><BR ALIGN="LEFT"/>
      Train resistance-profile model<BR ALIGN="LEFT"/>
      • training / evaluation<BR ALIGN="LEFT"/>
      • model artifact<BR ALIGN="LEFT"/>
      • feature list preserved
    >];

    lvl2_backend [label=<
      <B>neural_network.py</B><BR ALIGN="LEFT"/>
      Backend learners / model wrappers<BR ALIGN="LEFT"/>
      used by the ML protocol
    >];

    lvl2_dt_gate [label=<
      <B>Run Level 2 decision tree?</B>
    > shape=diamond fillcolor="#FFF2CC"];

    lvl2_dt [label=<
      <B>decision_tree_branch.py</B><BR ALIGN="LEFT"/>
      <B>Level 2 decision tree</B><BR ALIGN="LEFT"/>
      Interpret AMR-associated rules<BR ALIGN="LEFT"/>
      • root / branch features<BR ALIGN="LEFT"/>
      • rule extraction<BR ALIGN="LEFT"/>
      • path-based interactions
    > fillcolor="#FCE8E8"];

    lvl2_conf [label=<
      <B>Level 2 post-tree confidence</B><BR ALIGN="LEFT"/>
      Happens after tree construction<BR ALIGN="LEFT"/>
      • bootstrap stability<BR ALIGN="LEFT"/>
      • mutual information<BR ALIGN="LEFT"/>
      • feature confidence scores
    > fillcolor="#FCE8E8"];

    lvl2_output [label=<
      <B>Level 2 outputs</B><BR ALIGN="LEFT"/>
      • trained Level 2 model<BR ALIGN="LEFT"/>
      • selected AMR features<BR ALIGN="LEFT"/>
      • Level 2 selected manifest<BR ALIGN="LEFT"/>
      • optional DT explanations<BR ALIGN="LEFT"/>
      • optional confidence summaries
    > fillcolor="#DDF5DD"];

    lvl2_label -> lvl2_context;
    lvl2_context -> lvl2_filter;
    lvl2_filter -> lvl2_selected_manifest;
    lvl2_filter -> lvl2_selector;
    lvl2_selector -> lvl2_ml;
    lvl2_ml -> lvl2_backend;
    lvl2_backend -> lvl2_dt_gate;
    lvl2_dt_gate -> lvl2_dt [label="yes"];
    lvl2_dt_gate -> lvl2_output [label="no"];
    lvl2_dt -> lvl2_conf;
    lvl2_conf -> lvl2_output;
    lvl2_selected_manifest -> lvl2_output;
  }

  two_level_controller -> lvl2_label [style=dashed];
  lvl1_output -> lvl2_context [label="group context"];
  feature_manifest -> lvl2_selected_manifest [style=dashed label="subset by retained features"];

  // ============================================================
  // COMBINED TRAINING OUTPUTS
  // ============================================================
  subgraph cluster_results {
    label="Stage 3 — Combined training outputs and query-ready registry";
    style="rounded,filled";
    color="#D6E4F0";
    fillcolor="#F8FBFF";
    fontsize=14;

    combined_output [label=<
      <B>Combined two-level result</B><BR ALIGN="LEFT"/>
      • strain / group assignment model<BR ALIGN="LEFT"/>
      • resistance profile model<BR ALIGN="LEFT"/>
      • selected feature sets for both levels<BR ALIGN="LEFT"/>
      • selected marker manifests<BR ALIGN="LEFT"/>
      • DT rules / interactions where enabled<BR ALIGN="LEFT"/>
      • confidence summaries
    > fillcolor="#CFEFD0"];

    registry [label=<
      <B>two_level_model_registry.json</B><BR ALIGN="LEFT"/>
      Query-ready trained registry<BR ALIGN="LEFT"/>
      Stores:<BR ALIGN="LEFT"/>
      • Level 1 model path<BR ALIGN="LEFT"/>
      • Level 1 selected features<BR ALIGN="LEFT"/>
      • Level 1 selected manifest path<BR ALIGN="LEFT"/>
      • Level 2 model path(s)<BR ALIGN="LEFT"/>
      • Level 2 selected features<BR ALIGN="LEFT"/>
      • Level 2 selected manifest path(s)<BR ALIGN="LEFT"/>
      • encoding / configuration metadata
    > fillcolor="#E9FFF2"];

    final_outputs [label=<
      <B>Final exported outputs</B><BR ALIGN="LEFT"/>
      • filtered matrices<BR ALIGN="LEFT"/>
      • feature manifests<BR ALIGN="LEFT"/>
      • selected feature manifests<BR ALIGN="LEFT"/>
      • RF-FDR / FDR statistics<BR ALIGN="LEFT"/>
      • trained model artifacts<BR ALIGN="LEFT"/>
      • decision-tree rules<BR ALIGN="LEFT"/>
      • confidence summaries<BR ALIGN="LEFT"/>
      • run summary JSON
    > fillcolor="#E9FFF2"];

    gnn_outputs [label=<
      <B>Network / GNN-ready outputs</B><BR ALIGN="LEFT"/>
      • ranked feature list<BR ALIGN="LEFT"/>
      • interaction graph<BR ALIGN="LEFT"/>
      • sample-feature network<BR ALIGN="LEFT"/>
      • adjacency matrices
    > fillcolor="#E9FFF2"];

    lvl1_output -> combined_output;
    lvl2_output -> combined_output;
    combined_output -> registry;
    combined_output -> final_outputs;
    final_outputs -> gnn_outputs;
  }

  // ============================================================
  // USER-FACING QUERY / PREDICTION MODE
  // ============================================================
  subgraph cluster_query {
    label="Stage 4 — User-facing query / prediction mode";
    style="rounded,filled";
    color="#EAD1DC";
    fillcolor="#FFF8FC";
    fontsize=14;

    query_input_choice [label=<
      <B>New user sample</B><BR ALIGN="LEFT"/>
      Supported query concepts:<BR ALIGN="LEFT"/>
      • raw FASTA / consensus / assembly<BR ALIGN="LEFT"/>
      • or prebuilt genomic feature row / matrix
    > shape=parallelogram fillcolor="#FFF8DC"];

    raw_sequence_input [label=<
      <B>Raw DNA sequence input</B><BR ALIGN="LEFT"/>
      FASTA-like sequence supplied by user<BR ALIGN="LEFT"/>
      Not used for new feature discovery
    > shape=parallelogram fillcolor="#FFF8DC"];

    matrix_query_input [label=<
      <B>Prebuilt query matrix input</B><BR ALIGN="LEFT"/>
      Already represented as genomic features<BR ALIGN="LEFT"/>
      aligned to trained feature names where possible
    > shape=parallelogram fillcolor="#FFF8DC"];

    raw_encoder [label=<
      <B>sequence_query_encoder.py</B><BR ALIGN="LEFT"/>
      Raw-sequence to selected-feature matrix<BR ALIGN="LEFT"/>
      • load selected marker manifest<BR ALIGN="LEFT"/>
      • use saved context sequence<BR ALIGN="LEFT"/>
      • map context against query DNA<BR ALIGN="LEFT"/>
      • BLAST if available<BR ALIGN="LEFT"/>
      • exact context fallback in auto mode<BR ALIGN="LEFT"/>
      • handle strand / reverse complement<BR ALIGN="LEFT"/>
      • extract marker-centre nucleotide<BR ALIGN="LEFT"/>
      • encode using training rule
    > fillcolor="#FFF2CC"];

    blast_mapping [label=<
      <B>Context mapping</B><BR ALIGN="LEFT"/>
      For each selected marker:<BR ALIGN="LEFT"/>
      • map flanking context<BR ALIGN="LEFT"/>
      • identify query location<BR ALIGN="LEFT"/>
      • classify mapping status<BR ALIGN="LEFT"/>
      • unique / multi-hit / no-hit / low-confidence
    > fillcolor="#FFF2CC"];

    allele_calling [label=<
      <B>Allele extraction and encoding</B><BR ALIGN="LEFT"/>
      For each selected feature:<BR ALIGN="LEFT"/>
      • read observed query nucleotide<BR ALIGN="LEFT"/>
      • compare with REF / ALT / baseline<BR ALIGN="LEFT"/>
      • encode as 0 / 1<BR ALIGN="LEFT"/>
      • unresolved values are flagged<BR ALIGN="LEFT"/>
      • complete model-compatible row is produced
    > fillcolor="#FFF2CC"];

    query_matrix [label=<
      <B>One-sample selected-feature matrix</B><BR ALIGN="LEFT"/>
      Query sample projected onto trained feature space<BR ALIGN="LEFT"/>
      • Level 1 selected features<BR ALIGN="LEFT"/>
      • Level 2 selected features<BR ALIGN="LEFT"/>
      • no new statistical filtering<BR ALIGN="LEFT"/>
      • no new feature discovery
    > fillcolor="#DDF5DD"];

    raw_evidence [label=<
      <B>Raw-sequence evidence outputs</B><BR ALIGN="LEFT"/>
      • raw_sequence_selected_feature_matrix.csv<BR ALIGN="LEFT"/>
      • raw_sequence_feature_calls.tsv<BR ALIGN="LEFT"/>
      • raw_sequence_mapping_summary.json<BR ALIGN="LEFT"/>
      • marker recovery metrics<BR ALIGN="LEFT"/>
      • unresolved / ambiguous marker report
    > fillcolor="#E9FFF2"];

    query_engine [label=<
      <B>query_engine.py</B><BR ALIGN="LEFT"/>
      Inference-only query controller<BR ALIGN="LEFT"/>
      • load trained registry<BR ALIGN="LEFT"/>
      • load query matrix<BR ALIGN="LEFT"/>
      • align to saved feature lists<BR ALIGN="LEFT"/>
      • fill missing trained features conservatively<BR ALIGN="LEFT"/>
      • preserve evidence flags
    >];

    query_lvl1 [label=<
      <B>Apply saved Level 1 model</B><BR ALIGN="LEFT"/>
      Answer:<BR ALIGN="LEFT"/>
      Where does this strain/sample belong?
    > fillcolor="#E7F2FF"];

    query_lvl2_select [label=<
      <B>Select Level 2 model context</B><BR ALIGN="LEFT"/>
      • use global Level 2 model where configured<BR ALIGN="LEFT"/>
      • or use group-specific Level 2 model<BR ALIGN="LEFT"/>
      • Level 1 prediction can guide context
    > fillcolor="#FFF2CC"];

    query_lvl2 [label=<
      <B>Apply saved Level 2 model</B><BR ALIGN="LEFT"/>
      Answer:<BR ALIGN="LEFT"/>
      What resistance profile is predicted?
    > fillcolor="#FCE8E8"];

    query_report [label=<
      <B>User-facing query report</B><BR ALIGN="LEFT"/>
      • predicted strain / group<BR ALIGN="LEFT"/>
      • predicted resistance profile<BR ALIGN="LEFT"/>
      • support values where available<BR ALIGN="LEFT"/>
      • supporting selected markers<BR ALIGN="LEFT"/>
      • observed nucleotides<BR ALIGN="LEFT"/>
      • marker recovery summary<BR ALIGN="LEFT"/>
      • unresolved / ambiguous marker warnings
    > fillcolor="#DDF5DD"];

    query_input_choice -> raw_sequence_input;
    query_input_choice -> matrix_query_input;

    raw_sequence_input -> raw_encoder;
    raw_encoder -> blast_mapping;
    blast_mapping -> allele_calling;
    allele_calling -> query_matrix;
    allele_calling -> raw_evidence;

    matrix_query_input -> query_matrix;

    query_matrix -> query_engine;
    query_engine -> query_lvl1;
    query_lvl1 -> query_lvl2_select;
    query_lvl2_select -> query_lvl2;
    query_lvl2 -> query_report;
    raw_evidence -> query_report;
  }

  registry -> query_engine [style=dashed label="saved models + selected manifests"];
  registry -> raw_encoder [style=dashed label="selected marker context"];
}