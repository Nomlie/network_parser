digraph NetworkParser_Workflow {
    graph [
        rankdir=TB,
        bgcolor="white",
        compound=true,
        splines=ortho,
        nodesep=0.55,
        ranksep=0.75,
        fontname="Helvetica",
        label="NetworkParser AMR Feature-Selection and Query-Inference Workflow",
        labelloc=t,
        fontsize=22
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Helvetica",
        fontsize=11,
        color="#4A5568",
        fillcolor="#F7FAFC"
    ];

    edge [
        fontname="Helvetica",
        fontsize=10,
        color="#4A5568",
        arrowsize=0.8
    ];

    // ============================================================
    // INPUTS
    // ============================================================

    subgraph cluster_inputs {
        label="Inputs";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        genomic_input [
            label="Genomic input\nVCF directory / variant matrix / FASTA / FASTQ",
            fillcolor="#EBF8FF"
        ];

        metadata_input [
            label="Metadata input\nSupervised labels\nlineage / phenotype / AMR endpoint",
            fillcolor="#EBF8FF"
        ];

        reference_input [
            label="Reference genome / annotation\nOptional but recommended for query-ready manifests",
            fillcolor="#EBF8FF"
        ];

        config_input [
            label="NetworkParser configuration\nQC thresholds, filter method,\npanel settings, hierarchy labels",
            fillcolor="#EBF8FF"
        ];
    }

    // ============================================================
    // PREPROCESSING
    // ============================================================

    subgraph cluster_preprocessing {
        label="Preprocessing and Matrix Construction";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        dataloader [
            label="DataLoader",
            fillcolor="#F0FFF4"
        ];

        vcf_qc [
            label="VCF / matrix QC\nQUAL / depth / mapping filters\nbiallelic SNP handling where applicable",
            fillcolor="#F0FFF4"
        ];

        binary_matrix [
            label="Sample × genomic-feature matrix\nbinary / categorical marker states",
            fillcolor="#F0FFF4"
        ];

        feature_manifest [
            label="Feature manifest\nFeature ID, position, REF, ALT,\nbaseline allele, context sequence",
            fillcolor="#F0FFF4"
        ];

        structural_cleanup [
            label="Lightweight structural cleanup\nremove invariant features\nNaN / missing → baseline-like zero\nminor-count / presence filters",
            fillcolor="#F0FFF4"
        ];
    }

    genomic_input -> dataloader;
    reference_input -> dataloader;
    config_input -> dataloader;

    dataloader -> vcf_qc;
    vcf_qc -> binary_matrix;
    vcf_qc -> feature_manifest;
    binary_matrix -> structural_cleanup;

    // ============================================================
    // SUPERVISED ALIGNMENT
    // ============================================================

    subgraph cluster_alignment {
        label="Supervised Sample Alignment";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        label_normalization [
            label="Label normalization\nclean missing / invalid labels\nstandardize label text",
            fillcolor="#FFFAF0"
        ];

        sample_alignment [
            label="Align genomic matrix with metadata\nkeep samples with valid labels\nand genomic features",
            fillcolor="#FFFAF0"
        ];
    }

    metadata_input -> label_normalization;
    structural_cleanup -> sample_alignment;
    label_normalization -> sample_alignment;

    // ============================================================
    // CENTRAL FEATURE FILTERING
    // ============================================================

    subgraph cluster_filtering {
        label="Pre-Model Statistical Feature Filtering";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        central_filter [
            label="Configured central feature filter\nχ²-FDR / Fisher-FDR / RF-FDR /\npermutation-FDR",
            fillcolor="#FFF5F5"
        ];

        association_tests [
            label="Per-feature statistical testing\nfeature × label association",
            fillcolor="#FFF5F5"
        ];

        multiple_testing [
            label="Multiple-testing correction\nFDR-BH or configured correction",
            fillcolor="#FFF5F5"
        ];

        filtered_matrix [
            label="Statistically filtered matrix\nonly retained genomic features\ncontinue downstream",
            fillcolor="#FFF5F5"
        ];

        filter_summary [
            label="Filtering artifacts\nranked feature table\np-values / q-values / summary JSON",
            fillcolor="#FFF5F5"
        ];
    }

    sample_alignment -> central_filter;
    config_input -> central_filter;

    central_filter -> association_tests;
    association_tests -> multiple_testing;
    multiple_testing -> filtered_matrix;
    multiple_testing -> filter_summary;

    // ============================================================
    // FEATURE PANEL SELECTION
    // ============================================================

    subgraph cluster_panel {
        label="Ranked Feature-Panel Separability Check";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        rank_features [
            label="Rank retained features\nby statistical strength",
            fillcolor="#FAF5FF"
        ];

        evaluate_panels [
            label="Evaluate top-N feature panels\ncompact separability diagnostic",
            fillcolor="#FAF5FF"
        ];

        selected_panel [
            label="Selected model-ready feature panel\ncompact, interpretable matrix",
            fillcolor="#FAF5FF"
        ];

        selected_manifest [
            label="Selected-feature manifest\nquery-ready marker metadata",
            fillcolor="#FAF5FF"
        ];
    }

    filtered_matrix -> rank_features;
    filter_summary -> rank_features;
    rank_features -> evaluate_panels;
    evaluate_panels -> selected_panel;
    feature_manifest -> selected_manifest;
    selected_panel -> selected_manifest;

    // ============================================================
    // ML PROTOCOL
    // ============================================================

    subgraph cluster_ml {
        label="ML Protocol and Model Screening";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        ml_protocol [
            label="ML protocol matrix\naligned selected features + labels",
            fillcolor="#FFF5F7"
        ];

        model_selector [
            label="Model selector / diagnostic probes\nbalanced-accuracy screening\nstratified where feasible",
            fillcolor="#FFF5F7"
        ];

        final_model [
            label="Final trained supervised model\nsaved with selected features\nand label encoder where needed",
            fillcolor="#FFF5F7"
        ];

        ml_summary [
            label="ML artifacts\ntrained model\nprotocol summary\ntraining diagnostics",
            fillcolor="#FFF5F7"
        ];
    }

    selected_panel -> ml_protocol;
    sample_alignment -> ml_protocol;
    ml_protocol -> model_selector;
    model_selector -> final_model;
    final_model -> ml_summary;

    // ============================================================
    // HIERARCHY TRAINING
    // ============================================================

    subgraph cluster_hierarchy {
        label="Two-Level / Recursive Hierarchy Training";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        hierarchy_start [
            label="Hierarchy label order\nlevel 1 → level 2 → terminal endpoint",
            fillcolor="#FFFFF0"
        ];

        node_training [
            label="Train hierarchy node\nsubset samples by parent branch\nthen repeat filtering + panel + model",
            fillcolor="#FFFFF0"
        ];

        support_check [
            label="Per-node support check\nsufficient labels?\nstratified CV feasible?",
            fillcolor="#FFFFF0"
        ];

        deterministic_node [
            label="Deterministic / skipped node\nsingle child or insufficient support",
            fillcolor="#FFFFF0"
        ];

        fallback_model [
            label="Fallback model where configured\nglobal or terminal fallback\nrecorded explicitly",
            fillcolor="#FFFFF0"
        ];

        hierarchy_registry [
            label="Hierarchy model registry\nnode models\nselected features\nselected manifests\nfallback status",
            fillcolor="#FFFFF0"
        ];
    }

    metadata_input -> hierarchy_start;
    selected_panel -> node_training;
    hierarchy_start -> node_training;
    node_training -> support_check;

    support_check -> central_filter [
        label="trainable node",
        ltail=cluster_hierarchy,
        lhead=cluster_filtering
    ];

    support_check -> deterministic_node [
        label="not trainable"
    ];

    deterministic_node -> fallback_model;
    fallback_model -> hierarchy_registry;
    final_model -> hierarchy_registry;
    selected_manifest -> hierarchy_registry;

    // ============================================================
    // TRAINING OUTPUTS
    // ============================================================

    subgraph cluster_training_outputs {
        label="Training / Discovery Outputs";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        ranked_features [
            label="Ranked feature list\nstatistical evidence + model relevance",
            fillcolor="#F7FAFC"
        ];

        sample_feature_network [
            label="Sample-feature network\nselected marker states per sample",
            fillcolor="#F7FAFC"
        ];

        gnn_outputs [
            label="GNN-ready matrices\nfeature adjacency\nsample-feature adjacency\nnode metadata",
            fillcolor="#F7FAFC"
        ];

        model_registry [
            label="Model registry / portable bundle\nmodels + selected-feature metadata\nquery-ready knowledge object",
            fillcolor="#F7FAFC"
        ];
    }

    filter_summary -> ranked_features;
    ml_summary -> ranked_features;
    selected_panel -> sample_feature_network;
    sample_feature_network -> gnn_outputs;
    hierarchy_registry -> model_registry;
    ml_summary -> model_registry;
    selected_manifest -> model_registry;

    // ============================================================
    // QUERY INPUTS
    // ============================================================

    subgraph cluster_query {
        label="Query / Inference Mode";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        query_input [
            label="New query sample\nmatrix / VCF / FASTA / FASTQ",
            fillcolor="#EBF4FF"
        ];

        fastq_bridge [
            label="FASTQ bridge if needed\nFASTQ → alignment → BAM → VCF",
            fillcolor="#EBF4FF"
        ];

        query_encoder [
            label="Query feature encoder\nuses saved selected-feature manifest\nno discovery-time filtering",
            fillcolor="#EBF4FF"
        ];

        query_alignment [
            label="Align query to trained feature space\nmissing trained features → 0\nextra query features ignored",
            fillcolor="#EBF4FF"
        ];

        route_prediction [
            label="Registry-guided prediction\nLevel 1 / Level 2 / recursive hierarchy route",
            fillcolor="#EBF4FF"
        ];

        marker_evidence [
            label="Marker-evidence audit\nresolved active markers\nresolved baseline states\nunresolved zero-fill\ncoverage flags",
            fillcolor="#EBF4FF"
        ];

        query_outputs [
            label="Query outputs\nprediction CSV / compact TSV\nHTML report\nroute audit JSON\nalignment summary",
            fillcolor="#EBF4FF"
        ];
    }

    model_registry -> query_encoder;
    query_input -> fastq_bridge [
        label="if FASTQ"
    ];
    fastq_bridge -> query_encoder;
    query_input -> query_encoder [
        label="matrix / VCF / FASTA"
    ];
    query_encoder -> query_alignment;
    query_alignment -> route_prediction;
    model_registry -> route_prediction;
    query_alignment -> marker_evidence;
    route_prediction -> query_outputs;
    marker_evidence -> query_outputs;

    // ============================================================
    // EVALUATION
    // ============================================================

    subgraph cluster_evaluation {
        label="Evaluation and Leakage-Aware Validation";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        holdout_eval [
            label="Holdout evaluation\ncompare predictions to metadata truth",
            fillcolor="#F0F5FF"
        ];

        metrics [
            label="Performance metrics\nbalanced accuracy\nsensitivity / specificity\nF1 / PPV / NPV\nconfusion matrix",
            fillcolor="#F0F5FF"
        ];

        repeated_cv [
            label="Repeated cross-validation\nsplit first\nfilter inside training fold\ntrain inside training fold\nevaluate held-out fold",
            fillcolor="#F0F5FF"
        ];

        stability [
            label="CV feature stability\nfold-wise retained markers\naggregate robustness summary",
            fillcolor="#F0F5FF"
        ];
    }

    query_outputs -> holdout_eval;
    metadata_input -> holdout_eval;
    holdout_eval -> metrics;

    sample_alignment -> repeated_cv;
    repeated_cv -> central_filter [
        label="inside each training fold",
        ltail=cluster_evaluation,
        lhead=cluster_filtering
    ];
    repeated_cv -> stability;

    // ============================================================
    // VISUALIZATION
    // ============================================================

    subgraph cluster_visualization {
        label="Downstream Visualization";
        color="#A0AEC0";
        style="rounded,dashed";
        fontsize=14;

        training_viz [
            label="Training visualizations\nmarker counts by level\nmarker overlap\nlevel graph\nselected-marker heatmaps",
            fillcolor="#FFF5F7"
        ];

        query_viz [
            label="Query visualizations\nprediction routes\nsupport summaries\nmarker quality\nroute graph",
            fillcolor="#FFF5F7"
        ];

        separation_viz [
            label="Feature-space separation views\nhierarchy-aware clustering\nnot a phylogenetic tree",
            fillcolor="#FFF5F7"
        ];
    }

    model_registry -> training_viz;
    query_outputs -> query_viz;
    selected_panel -> separation_viz;
    metadata_input -> separation_viz;

    // ============================================================
    // ARCHITECTURAL NOTE
    // ============================================================

    rule_pre_filter [
        label="Rule: statistical filtering happens BEFORE\nmodel screening and hierarchy training",
        shape=note,
        fillcolor="#FED7D7",
        color="#C53030",
        fontsize=12
    ];

    central_filter -> rule_pre_filter [
        style=dashed,
        arrowhead=none
    ];

    // ============================================================
    // RANKING
    // ============================================================

    { rank=same; genomic_input; metadata_input; reference_input; config_input; }
    { rank=same; ranked_features; sample_feature_network; gnn_outputs; model_registry; }
}