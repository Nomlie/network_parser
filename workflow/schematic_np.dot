digraph NetworkParser_PresentationStyle {
    graph [
        rankdir=TB,
        splines=ortho,
        nodesep=0.45,
        ranksep=0.75,
        pad=0.3,
        bgcolor="white",
        fontname="Helvetica",
        fontsize=18,
        label="NetworkParser — Simplified Workflow for Scientific Audiences\nInput → matrix construction → statistical filtering → interpretable discovery → optional validation → graph-ready outputs"
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Helvetica",
        fontsize=10,
        color="#666666",
        fillcolor="#F7F7F7",
        margin="0.08,0.05"
    ];

    edge [
        color="#7A7A7A",
        arrowsize=0.75,
        penwidth=1.1,
        fontname="Helvetica",
        fontsize=9
    ];

    // ------------------------------------------------------------------
    // Title / entry
    // ------------------------------------------------------------------
    start [shape=ellipse, fillcolor="#DFF0D8", color="#7AA66A", label="Start"];

    input [fillcolor="#DFF0D8", color="#7AA66A", label="Input data\n• Genomic variation files\n• Sample metadata\n• Trait / phenotype labels"];

    // ------------------------------------------------------------------
    // Stage 1
    // ------------------------------------------------------------------
    subgraph cluster_stage1 {
        label="Stage 1 — Data loading, preprocessing, and matrix construction";
        color="#CFCFCF";
        style="rounded,dashed";

        s1_1 [fillcolor="#D9ECF7", color="#7EA6C6", label="Detect input type\n• Per-sample genomic files\n• Or prebuilt matrix / table"];
        s1_2 [fillcolor="#D9ECF7", color="#7EA6C6", label="Load metadata\n• Validate target label\n• Prepare sample matching"];
        s1_3 [fillcolor="#FBE6BF", color="#C79C52", label="Parse each sample's genomic variation\n• Extract polymorphic sites\n• Track callable positions"];
        s1_4 [fillcolor="#FBE6BF", color="#C79C52", label="Apply quality control\n• Site-level filtering\n• Depth / genotype support\n• Keep high-confidence variation"];
        s1_5 [fillcolor="#FBE6BF", color="#C79C52", label="Build cohort-wide site set\n• Merge sites across samples\n• Count support per site"];
        s1_6 [fillcolor="#FBE6BF", color="#C79C52", label="Cohort presence filtering\n• Remove sites seen too rarely\n• Retain reproducible markers"];
        s1_7 [fillcolor="#DFF0D8", color="#7AA66A", label="Construct ordered allele representation\nfor all retained sites"];
        s1_8 [fillcolor="#DFF0D8", color="#7AA66A", label="Choose baseline encoding\n• Reference baseline\nor\n• Cohort-majority baseline"];
        s1_9 [fillcolor="#BFE7E3", color="#5A9E99", label="Binary encoding\n• Baseline = 0\n• Alternative state = 1"];
        s1_10 [fillcolor="#D9ECF7", color="#7EA6C6", label="Compute matrix summaries\n• Feature counts\n• Sample counts\n• Sparsity / frequency overview"];
        s1_11 [fillcolor="#F6D6D0", color="#C9877B", label="Light preprocessing\n• Remove invariant features\n• Remove very low-support features"];
        s1_12 [fillcolor="#C8D9F1", color="#7B97BD", label="Optional artifact export\n• Matrix tables\n• FASTA-like outputs\n• Annotation / lookup files"];
        stage1_out [shape=ellipse, fillcolor="#DFF0D8", color="#7AA66A", label="Aligned binary feature matrix"];

        s1_1 -> s1_2 -> s1_3 -> s1_4 -> s1_5 -> s1_6 -> s1_7 -> s1_8 -> s1_9 -> s1_10 -> s1_11 -> s1_12 -> stage1_out;
    }

    // ------------------------------------------------------------------
    // Stage 2
    // ------------------------------------------------------------------
    subgraph cluster_stage2 {
        label="Stage 2 — Central statistical feature filtering";
        color="#CFCFCF";
        style="rounded,dashed";

        s2_1 [fillcolor="#EFDCEB", color="#B88CAD", label="Test each genomic feature\nagainst the phenotype / grouping"];
        s2_2 [fillcolor="#DFF0D8", color="#7AA66A", label="Choose appropriate association test\n• Chi-square\n• Fisher's exact"];
        s2_3 [fillcolor="#DFF0D8", color="#7AA66A", label="Correct for multiple testing\n• FDR-based filtering"];
        s2_4 [fillcolor="#D9ECF7", color="#7EA6C6", label="Retain statistically informative features"];
        stage2_out [shape=ellipse, fillcolor="#DFF0D8", color="#7AA66A", label="Filtered feature matrix"];

        s2_1 -> s2_2 -> s2_3 -> s2_4 -> stage2_out;
    }

    // ------------------------------------------------------------------
    // Stage 3
    // ------------------------------------------------------------------
    subgraph cluster_stage3 {
        label="Stage 3 — Model screening and interpretable branch selection";
        color="#CFCFCF";
        style="rounded,dashed";

        s3_1 [fillcolor="#D9ECF7", color="#7EA6C6", label="Prepare ML-ready matrix\nand aligned labels"];
        s3_2 [fillcolor="#D9ECF7", color="#7EA6C6", label="Screen supported model families\nfor this dataset"];
        s3_3 [fillcolor="#F6D6D0", color="#C9877B", label="Decide analysis path\n• Predictive ML branch\n• Interpretable decision-tree branch"];
        stage3_out [shape=ellipse, fillcolor="#DFF0D8", color="#7AA66A", label="Selected model path(s)"];

        s3_1 -> s3_2 -> s3_3 -> stage3_out;
    }

    // ------------------------------------------------------------------
    // Stage 4
    // ------------------------------------------------------------------
    subgraph cluster_stage4 {
        label="Stage 4 — Interpretable decision-tree discovery";
        color="#CFCFCF";
        style="rounded,dashed";

        s4_1 [fillcolor="#F6D6D0", color="#C9877B", label="Train interpretable decision tree\non centrally filtered features"];
        s4_2 [fillcolor="#F6D6D0", color="#C9877B", label="Extract decision rules\nand hierarchical splits"];
        s4_3 [fillcolor="#E5C5DD", color="#A77AA1", label="Score feature confidence\n• Bootstrap stability\n• Mutual information\n• Robust support"];
        s4_4 [fillcolor="#E5C5DD", color="#A77AA1", label="Detect feature interactions\nfrom decision paths"];
        stage4_out [shape=ellipse, fillcolor="#DFF0D8", color="#7AA66A", label="Ranked features + interaction candidates"];

        s4_1 -> s4_2 -> s4_3 -> s4_4 -> stage4_out;
    }

    // ------------------------------------------------------------------
    // Stage 5
    // ------------------------------------------------------------------
    subgraph cluster_stage5 {
        label="Stage 5 — Optional downstream validation";
        color="#CFCFCF";
        style="rounded,dashed";

        s5_1 [fillcolor="#FBE6BF", color="#C79C52", label="Validate selected markers\nand interactions"];
        s5_2 [fillcolor="#FBE6BF", color="#C79C52", label="Apply additional statistical checks\nfor stronger confidence"];
        stage5_out [shape=ellipse, fillcolor="#DFF0D8", color="#7AA66A", label="Validated findings"];

        s5_1 -> s5_2 -> stage5_out;
    }

    // ------------------------------------------------------------------
    // Stage 6
    // ------------------------------------------------------------------
    subgraph cluster_stage6 {
        label="Stage 6 — Final scientific outputs";
        color="#CFCFCF";
        style="rounded,dashed";

        o1 [fillcolor="#DFF0D8", color="#7AA66A", label="Ranked genomic markers"];
        o2 [fillcolor="#DFF0D8", color="#7AA66A", label="Decision rules\nthat explain group separation"];
        o3 [fillcolor="#D9ECF7", color="#7EA6C6", label="Feature interaction network"];
        o4 [fillcolor="#D9ECF7", color="#7EA6C6", label="Sample-feature network"];
        o5 [fillcolor="#D9ECF7", color="#7EA6C6", label="Graph-ready matrices\nfor downstream AI / GNN analysis"];
        o6 [fillcolor="#C8D9F1", color="#7B97BD", label="Exported reports / JSON summaries"];
    }

    finish [shape=ellipse, fillcolor="#DFF0D8", color="#7AA66A", label="Finish"];

    // ------------------------------------------------------------------
    // Flow
    // ------------------------------------------------------------------
    start -> input -> s1_1;
    stage1_out -> s2_1;
    stage2_out -> s3_1;
    stage3_out -> s4_1;
    stage4_out -> s5_1 [label="optional", fontsize=9];
    stage4_out -> o1;
    stage4_out -> o2;
    stage4_out -> o3;
    stage4_out -> o4;
    stage4_out -> o5;
    stage4_out -> o6;
    stage5_out -> o6;
    o6 -> finish;
}