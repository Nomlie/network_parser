#!/bin/bash
#PBS -l select=1:ncpus=24:mem=120GB
#PBS -P RCHPC
#PBS -l walltime=96:00:00
#PBS -m abe
#PBS -M nmfuphi@csir.co.za
#PBS -N np_prjca_12
#PBS -o /mnt/lustre/users/nmfuphi/phDproject/Results/pbs_logs/12_prjca_external_panel_bcftools.out
#PBS -e /mnt/lustre/users/nmfuphi/phDproject/Results/pbs_logs/12_prjca_external_panel_bcftools.err
#
# External PRJCA040523 FASTQ query with panel_bcftools (not whole-genome).
# Requires trained bundle (default: seeded 01) + PRJCA data on lustre.
#
#   qsub pbs_12_prjca_external_fastq.pbs
#   qsub -v LIMIT=5 pbs_12_prjca_external_fastq.pbs   # smoke
#   qsub -v BUNDLE=/path/to/bundle.npb pbs_12_prjca_external_fastq.pbs
#
set -euo pipefail

if [[ -n "${PBS_O_WORKDIR:-}" ]]; then
  cd "${PBS_O_WORKDIR}"
fi

CLUSTER_SCRIPTS="${CLUSTER_SCRIPTS:-/home/nmfuphi/network_parser/scripts/testing_scripts_cluster}"
if [[ ! -d "${CLUSTER_SCRIPTS}" ]]; then
  CLUSTER_SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

# shellcheck source=/dev/null
source "${CLUSTER_SCRIPTS}/00_env_cluster.sh"
# shellcheck source=/dev/null
source "${CLUSTER_SCRIPTS}/00_config.sh"

mkdir -p "${PBS_LOG_DIR}" "${RESULTS_ROOT}/PRJCA040523_external"

export N_JOBS="${N_JOBS:-24}"
export PROJECT_ROOT
export PYTHON_BIN="${PYTHON_BIN:-python}"
# Optional qsub -v: BUNDLE, LIMIT, RUN_NAME, SKIP_QUERY, SKIP_STAGE, SEED_RUN_NAME

cd "${PROJECT_ROOT}"
echo "PRJCA external FASTQ query | panel_bcftools"
bash "${CLUSTER_SCRIPTS}/12_prjca_external_fastq_query.sh"
echo "Finished PRJCA external at $(date)"
