#!/bin/bash
#PBS -l select=1:ncpus=24:mem=120GB
#PBS -P RCHPC
#PBS -l walltime=48:00:00
#PBS -m abe
#PBS -M nmfuphi@csir.co.za
#PBS -N np_prjca_hier_vcf
#PBS -o /mnt/lustre/users/nmfuphi/phDproject/Results/pbs_logs/14_prjca_hierarchy_seeded01_vcfs.out
#PBS -e /mnt/lustre/users/nmfuphi/phDproject/Results/pbs_logs/14_prjca_hierarchy_seeded01_vcfs.err
#
# Query Hierarchy_Lineage_AMR_Resistance_Profile_seeded_01 on existing Chinese VCFs + evaluate.
# No FASTQ re-calling. Labels: Lineage_clean, AMR_binary, Resistance_Profile_Collapsed.
#
#   qsub pbs_14_prjca_hierarchy_seeded01_vcf.pbs
#   qsub -v LIMIT=20 pbs_14_prjca_hierarchy_seeded01_vcf.pbs
#
set -euo pipefail

if [[ -n "${PBS_O_WORKDIR:-}" ]]; then
  cd "${PBS_O_WORKDIR}"
fi

CLUSTER_SCRIPTS="${CLUSTER_SCRIPTS:-/home/nmfuphi/network_parser/scripts/testing_scripts_cluster}"
if [[ ! -d "${CLUSTER_SCRIPTS}" ]]; then
  CLUSTER_SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

# shellcheck source=/dev/null
source "${CLUSTER_SCRIPTS}/00_env_cluster.sh"
# shellcheck source=/dev/null
source "${CLUSTER_SCRIPTS}/00_config.sh"

mkdir -p "${PBS_LOG_DIR}"

export N_JOBS="${N_JOBS:-24}"
export PROJECT_ROOT
export PYTHON_BIN="${PYTHON_BIN:-python}"

cd "${PROJECT_ROOT}"
bash "${CLUSTER_SCRIPTS}/14_prjca_hierarchy_seeded01_vcf_query.sh"
echo "Finished at $(date)"
