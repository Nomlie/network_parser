#!/bin/bash
#PBS -l select=1:ncpus=24:mem=120GB
#PBS -P RCHPC
#PBS -l walltime=96:00:00
#PBS -m abe
#PBS -M nmfuphi@csir.co.za
#PBS -N np_hier_02
#PBS -o /mnt/lustre/users/nmfuphi/phDproject/Results/pbs_logs/02_Lineage_family_Lineage_AMR_profile.out
#PBS -e /mnt/lustre/users/nmfuphi/phDproject/Results/pbs_logs/02_Lineage_family_Lineage_AMR_profile.err
#
# Submit:
#   mkdir -p /mnt/lustre/users/nmfuphi/phDproject/Results/pbs_logs
#   cd /home/nmfuphi/network_parser/scripts/testing_scripts_cluster
#   qsub pbs_02_Lineage_family_Lineage_AMR_profile.pbs
#
set -euo pipefail

if [[ -n "${PBS_O_WORKDIR:-}" ]]; then
  cd "${PBS_O_WORKDIR}"
fi

CLUSTER_SCRIPTS="${CLUSTER_SCRIPTS:-/home/nmfuphi/network_parser/scripts/testing_scripts_cluster}"
if [[ ! -d "${CLUSTER_SCRIPTS}" ]]; then
  CLUSTER_SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

# shellcheck source=/dev/null
source "${CLUSTER_SCRIPTS}/00_env_cluster.sh"
# shellcheck source=/dev/null
source "${CLUSTER_SCRIPTS}/00_config.sh"

mkdir -p "${PBS_LOG_DIR}" "${BASE_OUT}"

export N_JOBS="${N_JOBS:-24}"
export HIERARCHY_RESUME="${HIERARCHY_RESUME:-0}"
export RUN_LEAKAGE_AWARE_CV="${RUN_LEAKAGE_AWARE_CV:-1}"
export RUN_PANEL_ANNOTATION="${RUN_PANEL_ANNOTATION:-1}"
export GLOBAL_FALLBACK_LABELS="${GLOBAL_FALLBACK_LABELS:-none}"
export PROJECT_ROOT
export PYTHON_BIN="${PYTHON_BIN:-python}"

cd "${PROJECT_ROOT}"
echo "Experiment 02: Lineage_family → Lineage_clean → AMR_binary → Resistance_Profile_Collapsed"
bash "${CLUSTER_SCRIPTS}/02_Lineage_family_Lineage_AMR_profile.sh"
echo "Finished at $(date)"
