#!/usr/bin/env bash
set -euo pipefail

# ============================================================
# NetworkParser testing pipeline
# Combined from local git notes + testing_np workflow
#
# Flow:
#   optional git sanity check
#   subset -> hierarchy training -> bundle -> query
#   -> held-out model evaluation -> leakage-aware CV
# ============================================================

# -----------------------------
# 0. PATHS / LABELS
# -----------------------------

BASE="/Users/nmfuphicsir.co.za/Documents/pHDProject"
DATA="$BASE/Data/AFRO_TB"
CODE="$BASE/Code/network_parser"

VCF_DIR="$DATA/AFRO_TB_ANNOTATION_VCF"
META="$DATA/AFRO_dataset_meta.csv"
REF="$BASE/Code/VCF_2_Matrix/ref/H37Rv.gbk"

SUBSET_SCRIPT="$CODE/extract_subset.py"

SUBSET_DIR="$DATA/subset_valid_hierarchy"
TRAIN_DIR="$SUBSET_DIR/train"
TEST_DIR="$SUBSET_DIR/test"

RESULTS="$BASE/Results/ALL/chi2_fdr"
QUERY_OUT="$RESULTS/query_test_results"
EVAL_OUT="$RESULTS/model_evaluation_test"
CV_OUT="$RESULTS/cross_validation"

# Ordered hierarchy labels for recursive hierarchy training.
HIERARCHY_LABELS=(Country Lineage Pheno)

# CV targets to evaluate independently on TRAIN_DIR.
CV_LABELS=(Country Lineage Pheno)

# Held-out evaluation targets.
INTERMEDIATE_LABEL="Lineage"
TERMINAL_LABEL="Pheno"

N_JOBS=8
SEED=42

# Optional sample cap for extract_subset.py.
# Leave empty to let the subset script use its own full valid set / train-test logic.
SUBSET_N_SAMPLES=""

# Smoke-testing setting:
#   unfiltered = allows exploratory runs to continue if no FDR-significant features survive.
# Publication/serious run:
#   stop = fail loudly if no statistically supported features survive.
FEATURE_FILTER_FALLBACK="unfiltered"

# For smoke testing:
CV_REPEATS=1
CV_SPLITS=3

# Git helper is intentionally disabled by default.
# Set DO_GIT_COMMIT_PUSH=1 when you explicitly want the script to commit and push.
DO_GIT_COMMIT_PUSH="${DO_GIT_COMMIT_PUSH:-0}"
GIT_BRANCH="${GIT_BRANCH:-changesss}"
GIT_COMMIT_MSG="${GIT_COMMIT_MSG:-NetworkParser testing workflow}"
GIT_REMOTE_URL="https://github.com/Nomlie/network_parser.git"


# -----------------------------
# 1. HELPERS
# -----------------------------

section() {
  echo
  echo "============================================================"
  echo "$1"
  echo "============================================================"
}

require_path() {
  local label="$1"
  local path="$2"
  if [[ ! -e "$path" ]]; then
    echo "Missing $label: $path" >&2
    exit 1
  fi
}

command_has_arg() {
  local cmd="$1"
  local arg="$2"
  bash -lc "$cmd --help" 2>&1 | grep -q -- "$arg"
}

run_optional_git_sync() {
  section "0. Git sanity check"

  git remote set-url origin "$GIT_REMOTE_URL" || true
  git remote -v || true
  git status || true
  git rev-parse --abbrev-ref HEAD || true

  if [[ "$DO_GIT_COMMIT_PUSH" == "1" ]]; then
    git switch master || git checkout master
    git pull --rebase origin master
    git switch "$GIT_BRANCH" || git checkout -b "$GIT_BRANCH"
    git add .
    if git diff --cached --quiet; then
      echo "No staged changes to commit."
    else
      git commit -m "$GIT_COMMIT_MSG"
      git push --set-upstream origin "$GIT_BRANCH"
    fi
  else
    echo "Git commit/push skipped. Set DO_GIT_COMMIT_PUSH=1 to enable it."
  fi
}

build_subset_command() {
  local cmd=(python "$SUBSET_SCRIPT" --vcf-dir "$VCF_DIR" --meta-file "$META" --output-dir "$SUBSET_DIR")

  # Support both recent and older versions of extract_subset.py.
  if command_has_arg "python '$SUBSET_SCRIPT'" "--hierarchy-labels"; then
    cmd+=(--hierarchy-labels "${HIERARCHY_LABELS[@]}")
  elif command_has_arg "python '$SUBSET_SCRIPT'" "--required-label-columns"; then
    cmd+=(--required-label-columns "${HIERARCHY_LABELS[@]}")
  fi

  if command_has_arg "python '$SUBSET_SCRIPT'" "--train-ratio"; then
    cmd+=(--train-ratio 0.8)
  fi

  if command_has_arg "python '$SUBSET_SCRIPT'" "--seed"; then
    cmd+=(--seed "$SEED")
  elif command_has_arg "python '$SUBSET_SCRIPT'" "--random-seed"; then
    cmd+=(--random-seed "$SEED")
  fi

  if command_has_arg "python '$SUBSET_SCRIPT'" "--stratify-by"; then
    cmd+=(--stratify-by "$INTERMEDIATE_LABEL")
  fi

  if [[ -n "$SUBSET_N_SAMPLES" ]] && command_has_arg "python '$SUBSET_SCRIPT'" "--n-samples"; then
    cmd+=(--n-samples "$SUBSET_N_SAMPLES")
  fi

  printf '%q ' "${cmd[@]}"
}


# -----------------------------
# 2. SETUP
# -----------------------------

require_path "code directory" "$CODE"
require_path "VCF directory" "$VCF_DIR"
require_path "metadata file" "$META"
require_path "reference file" "$REF"
require_path "subset script" "$SUBSET_SCRIPT"

cd "$CODE"

mkdir -p "$SUBSET_DIR" "$RESULTS" "$QUERY_OUT" "$EVAL_OUT" "$CV_OUT"

run_optional_git_sync

section "NetworkParser testing pipeline"
echo "Code:      $CODE"
echo "VCF_DIR:   $VCF_DIR"
echo "META:      $META"
echo "REF:       $REF"
echo "TRAIN_DIR: $TRAIN_DIR"
echo "TEST_DIR:  $TEST_DIR"
echo "RESULTS:   $RESULTS"


# -----------------------------
# 3. SUBSET INTO TRAIN / TEST
# -----------------------------

section "1. Creating metadata-valid train/test subset"

SUBSET_CMD="$(build_subset_command)"
echo "$SUBSET_CMD"
eval "$SUBSET_CMD"

echo
echo "Train VCF count:"
find "$TRAIN_DIR" -type f \( -name "*.vcf" -o -name "*.vcf.gz" \) | wc -l

echo "Test VCF count:"
find "$TEST_DIR" -type f \( -name "*.vcf" -o -name "*.vcf.gz" \) | wc -l


# -----------------------------
# 4. TRAIN MULTI-LEVEL HIERARCHY MODEL
# -----------------------------

section "2. Training hierarchy model"

python -m network_parser.cli train-two-level \
  --genomic "$TRAIN_DIR" \
  --meta "$META" \
  --hierarchy_labels "${HIERARCHY_LABELS[@]}" \
  --central_feature_filter_method chi2_fdr \
  --feature_filter_fallback_strategy "$FEATURE_FILTER_FALLBACK" \
  --feature_panel_check on \
  --feature_panel_sizes 100,200,500,1000 \
  --ref_fasta "$REF" \
  --output_dir "$RESULTS" \
  --n_jobs "$N_JOBS" \
  --verbose


# -----------------------------
# 5. RESOLVE REGISTRY PATH
# -----------------------------

section "3. Resolving registry"

REGISTRY=""

if [[ -f "$RESULTS/hierarchical_model_registry.json" ]]; then
  REGISTRY="$RESULTS/hierarchical_model_registry.json"
elif [[ -f "$RESULTS/two_level_model_registry.json" ]]; then
  REGISTRY="$RESULTS/two_level_model_registry.json"
else
  echo "Could not find a model registry under: $RESULTS" >&2
  find "$RESULTS" -maxdepth 4 -type f -name "*registry*.json" -print >&2
  exit 1
fi

echo "Using registry: $REGISTRY"


# -----------------------------
# 6. BUILD PORTABLE BUNDLE
# -----------------------------

section "4. Building binary model bundle"

BUNDLE="$RESULTS/networkparser_model_bundle.npb"

python - <<PY
from pathlib import Path
from network_parser.model_bundle import build_bundle_from_registry

registry = Path("$REGISTRY")
bundle = Path("$BUNDLE")

build_bundle_from_registry(
    registry_path=registry,
    output_path=bundle,
    include_model_payloads=True,
)

print(f"Wrote bundle: {bundle}")
PY


# -----------------------------
# 7. QUERY HELD-OUT TEST SET
# -----------------------------

section "5. Querying held-out test set"

python -m network_parser.cli query \
  --genomic "$TEST_DIR" \
  --bundle "$BUNDLE" \
  --query_input_type vcf \
  --ref_fasta "$REF" \
  --output_dir "$QUERY_OUT" \
  --max_markers 20 \
  --n_jobs "$N_JOBS" \
  --verbose

echo
echo "Query outputs:"
find "$QUERY_OUT" -maxdepth 2 -type f | sort


# -----------------------------
# 8. HELD-OUT MODEL EVALUATION
# -----------------------------

section "6. Evaluating held-out predictions"

HIERARCHY_LABELS_CSV="$(IFS=,; echo "${HIERARCHY_LABELS[*]}")"

python - <<PY
from pathlib import Path
import pandas as pd

from network_parser.model_evaluation import (
    evaluate_predictions,
    load_labels_from_metadata,
)

META = Path("$META")
QUERY_OUT = Path("$QUERY_OUT")
EVAL_OUT = Path("$EVAL_OUT")
TERMINAL_LABEL = "$TERMINAL_LABEL"
INTERMEDIATE_LABEL = "$INTERMEDIATE_LABEL"
HIERARCHY_LABELS = "$HIERARCHY_LABELS_CSV".split(",")

pred_path = QUERY_OUT / "query_predictions.csv"
if not pred_path.exists():
    raise FileNotFoundError(f"Missing query prediction file: {pred_path}")

pred = pd.read_csv(pred_path)
if "sample_id" not in pred.columns:
    raise ValueError("query_predictions.csv must contain a sample_id column.")

# -----------------------------
# Terminal hierarchy evaluation
# -----------------------------
if "predicted_terminal_label" in pred.columns:
    y_pred_terminal = pred.set_index("sample_id")["predicted_terminal_label"]
elif "predicted_hierarchy_path" in pred.columns:
    parts = pred["predicted_hierarchy_path"].astype(str).str.split(" > ")
    y_pred_terminal = parts.str[-1]
    y_pred_terminal.index = pred["sample_id"].astype(str)
elif "predicted_level2_resistance_profile" in pred.columns:
    y_pred_terminal = pred.set_index("sample_id")["predicted_level2_resistance_profile"]
else:
    raise ValueError(
        "Could not find terminal prediction column. Expected predicted_terminal_label, "
        "predicted_hierarchy_path, or predicted_level2_resistance_profile."
    )

y_true_terminal = load_labels_from_metadata(
    meta_path=META,
    label_column=TERMINAL_LABEL,
)

terminal_summary = evaluate_predictions(
    y_true=y_true_terminal,
    y_pred=y_pred_terminal,
    class_support_scores=None,
    output_dir=EVAL_OUT / "terminal_label",
    level_name=f"terminal_{TERMINAL_LABEL}",
)

print("Terminal evaluation:", terminal_summary.get("artifacts", {}).get("summary_json"))

# -----------------------------
# Intermediate hierarchy evaluation
# -----------------------------
y_pred_intermediate = None

if "predicted_hierarchy_path" in pred.columns:
    try:
        label_index = HIERARCHY_LABELS.index(INTERMEDIATE_LABEL)
    except ValueError:
        label_index = 1
    parts = pred["predicted_hierarchy_path"].astype(str).str.split(" > ")
    y_pred_intermediate = parts.str[label_index]
    y_pred_intermediate.index = pred["sample_id"].astype(str)
elif "predicted_level1_identity" in pred.columns:
    y_pred_intermediate = pred.set_index("sample_id")["predicted_level1_identity"]

if y_pred_intermediate is None:
    print("Skipping intermediate evaluation: no intermediate prediction column found.")
else:
    y_true_intermediate = load_labels_from_metadata(
        meta_path=META,
        label_column=INTERMEDIATE_LABEL,
    )

    intermediate_summary = evaluate_predictions(
        y_true=y_true_intermediate,
        y_pred=y_pred_intermediate,
        class_support_scores=None,
        output_dir=EVAL_OUT / "intermediate_label",
        level_name=f"intermediate_{INTERMEDIATE_LABEL}",
    )

    print("Intermediate evaluation:", intermediate_summary.get("artifacts", {}).get("summary_json"))
PY

echo
echo "Evaluation outputs:"
find "$EVAL_OUT" -maxdepth 3 -type f | sort


# -----------------------------
# 9. LEAKAGE-AWARE REPEATED CV ON TRAINING SET
# -----------------------------
# CV is intentionally run on TRAIN_DIR only.
# TEST_DIR remains the final held-out evaluation set.

section "7. Running leakage-aware repeated CV on training subset"

CV_LABELS_CSV="$(IFS=,; echo "${CV_LABELS[*]}")"

python - <<PY
from pathlib import Path
import json

from network_parser.config import NetworkParserConfig
from network_parser.cross_validation import run_repeated_cv

TRAIN_DIR = Path("$TRAIN_DIR")
META = Path("$META")
REF = Path("$REF")
CV_OUT = Path("$CV_OUT")

labels = "$CV_LABELS_CSV".split(",")

config = NetworkParserConfig()
config.central_feature_filter_method = "chi2_fdr"
config.resolved_central_feature_filter_method = "chi2_fdr"
config.feature_filter_fallback_strategy = "$FEATURE_FILTER_FALLBACK"
config.run_feature_panel_separability_check = True
config.feature_panel_sizes = [100, 200, 500, 1000]
config.n_jobs = int("$N_JOBS")
config.random_state = int("$SEED")

if hasattr(config, "run_model_selector"):
    config.run_model_selector = True

all_summaries = {}

for target in labels:
    target = target.strip()
    if not target:
        continue

    out_dir = CV_OUT / target
    print(f"\n=== CV target: {target} ===")

    try:
        summary = run_repeated_cv(
            genomic_path=str(TRAIN_DIR),
            meta_path=str(META),
            label_column=target,
            output_dir=str(out_dir),
            config=config,
            ref_fasta=str(REF),
            n_repeats=int("$CV_REPEATS"),
            n_splits=int("$CV_SPLITS"),
            algorithm="auto",
            random_state=int("$SEED"),
        )
        all_summaries[target] = {
            "status": summary.get("status"),
            "successful_folds": summary.get("successful_folds"),
            "failed_folds": summary.get("failed_folds"),
            "actual_folds_per_repeat": summary.get("actual_folds_per_repeat"),
            "artifacts": summary.get("artifacts"),
        }
        print(json.dumps(all_summaries[target], indent=2))
    except Exception as exc:
        all_summaries[target] = {
            "status": "failed",
            "error": str(exc),
        }
        print(json.dumps(all_summaries[target], indent=2))

CV_OUT.mkdir(parents=True, exist_ok=True)
with open(CV_OUT / "all_cv_targets_summary.json", "w", encoding="utf-8") as handle:
    json.dump(all_summaries, handle, indent=2)

print(f"\nWrote combined CV summary: {CV_OUT / 'all_cv_targets_summary.json'}")
PY

echo
echo "CV outputs:"
find "$CV_OUT" -maxdepth 3 -type f | sort


# -----------------------------
# 10. QUICK METRIC VIEW
# -----------------------------

section "8. Quick metric view"

echo
echo "Held-out terminal evaluation summary:"
if [[ -f "$EVAL_OUT/terminal_label/model_performance_summary.json" ]]; then
  cat "$EVAL_OUT/terminal_label/model_performance_summary.json"
else
  echo "Missing terminal evaluation summary."
fi

echo
echo
echo "Held-out intermediate evaluation summary:"
if [[ -f "$EVAL_OUT/intermediate_label/model_performance_summary.json" ]]; then
  cat "$EVAL_OUT/intermediate_label/model_performance_summary.json"
else
  echo "Missing intermediate evaluation summary."
fi

echo
echo
echo "CV target summaries:"
if [[ -f "$CV_OUT/all_cv_targets_summary.json" ]]; then
  cat "$CV_OUT/all_cv_targets_summary.json"
else
  echo "Missing combined CV summary."
fi

section "Done."
